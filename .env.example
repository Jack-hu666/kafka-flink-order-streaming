# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=orders
KAFKA_PARTITIONS=3

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=orders
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# PyFlink
PYFLINK_WATERMARK_SECONDS=5
PYFLINK_WINDOW_SECONDS=60
PYFLINK_CHECKPOINT_MS=10000
